[Unit]
Description=Roomba Battery Checker daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/work/roomba-battery-checker
EnvironmentFile=/home/pi/work/roomba-battery-checker/.env
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/env npm run check-battery -- --daemon
Restart=always
RestartSec=30
KillSignal=SIGINT
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
