# Roomba認証情報
# ROOMBA_BLID: Roombaのユーザー名（BLID）
ROOMBA_BLID=your_blid
# ROOMBA_PASSWORD: Roombaのパスワード
ROOMBA_PASSWORD=your_password

# SMTP設定
# SMTP_SERVER: SMTPサーバーのホスト名（例: smtp.gmail.com）
SMTP_SERVER=smtp.gmail.com
# SMTP_PORT: SMTPサーバーのポート番号（通常は587）
SMTP_PORT=587
# SMTP_USER: SMTP認証用のユーザー名（送信元メールアドレスとしても使用されます）
SMTP_USER=smtp_user@example.com
# SMTP_PASSWORD: SMTP認証用のパスワード
SMTP_PASSWORD=smtp_password

# 通知先メールアドレス
# NOTIFICATION_EMAIL: 通知メールの送信先アドレス（カンマ区切りで複数指定可能）
# 例: NOTIFICATION_EMAIL=user1@example.com,user2@example.com
NOTIFICATION_EMAIL=notification@email.com
