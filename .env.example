# Roomba認証情報
# ROOMBA_BLID: Roombaのユーザー名（BLID）
ROOMBA_BLID=your_blid
# ROOMBA_PASSWORD: Roombaのパスワード
ROOMBA_PASSWORD=your_password

# SMTP設定
# SMTP_SERVER: SMTPサーバーのホスト名（例: smtp.gmail.com）
SMTP_SERVER=smtp.gmail.com
# SMTP_PORT: SMTPサーバーのポート番号（通常は587）
SMTP_PORT=587
# SMTP_USER: SMTP認証用のユーザー名（メールアドレス）
SMTP_USER=smtp_user@example.com
# SMTP_PASSWORD: SMTP認証用のパスワード
SMTP_PASSWORD=smtp_password

# 送信元メールアドレス
# SEND_FROM: メール送信元アドレス（省略時はSMTP_USERを使用）
# エイリアスアドレスを使用する場合などに指定
# SEND_FROM=alias@example.com

# 通知先メールアドレス
# SEND_TO: 通知メールの送信先アドレス（カンマ区切りで複数指定可能）
# 例: SEND_TO=user1@example.com,user2@example.com
SEND_TO=notification@email.com
